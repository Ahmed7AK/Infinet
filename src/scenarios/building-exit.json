    ]
  },
  "events": [],
  "captions": [
    {
      "at": 0.5,
      "text": "You're on a call with Hamad, on the office Wi-Fi."
    },
    {
      "on": "predict.edge",
      "text": "Infinet saw the Wi-Fi edge on its map, seconds early."
    },
    {
      "on": "check.pass",
