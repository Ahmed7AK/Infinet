  "proves": "FEATURE 1 · SEES THE DROP COMING",
  "zone": "office",
  "route": "building-exit",
  "durationS": 50,
  "prewarmS": 0,
  "startDelayS": 1.0,
  "defaultBaseline": "b1",
  "init": {
    "route": "wifi:office-corp",
